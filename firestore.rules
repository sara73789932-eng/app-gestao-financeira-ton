rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function estaLogado() {
      return request.auth != null;
    }

    function ehDono(uid) {
      return estaLogado() && request.auth.uid == uid;
    }

    function ehAdmin() {
      return estaLogado() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == 'admin';
    }

    match /usuarios/{uid} {
      // Usuário só lê o próprio documento; admin lê todos.
      allow read: if ehDono(uid) || ehAdmin();

      // Ninguém cria a própria conta (só admin cria, via console/app admin).
      allow create: if ehAdmin();

      // Usuário pode atualizar apenas deviceId/ultimoAcesso do próprio documento.
      // Admin pode atualizar qualquer campo (status, deviceId, role).
      allow update: if ehAdmin() ||
        (ehDono(uid) &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['deviceId', 'ultimoAcesso']));

      allow delete: if ehAdmin();

      match /entradas/{entradaId} {
        allow read, write: if ehDono(uid);
      }

      match /gastos/{gastoId} {
        allow read, write: if ehDono(uid);
      }
    }
  }
}
